{
  "name": "makan-translate-dev",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Development-only tooling for MAKAN Translate (tests, lint). Nothing the web app or extension loads depends on this file.",
  "scripts": {
    "test": "node tests/run-all.js",
    "test:web": "node tests/run-all.js --only=web",
    "test:ext": "node tests/run-all.js --only=ext",
    "test:firefox": "node tests/run-all.js --only=firefox",
    "build": "node build-manifests.js",
    "build:web": "node tools/build-web.js",
    "start": "npm start --prefix \"../exe translator\"",
    "app": "npm start --prefix \"../exe translator\"",
    "build:exe": "npm run build:win --prefix \"../exe translator\"",
    "build:portable": "npm run build:portable --prefix \"../exe translator\"",
    "build:installer": "npm run build:nsis --prefix \"../exe translator\""
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "docx": "9.8.1",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "jszip": "3.10.1",
    "pptxgenjs": "4.0.1",
    "selfsigned": "5.5.0",
    "web-ext": "10.7.0"
  }
}
